<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Signal Computer Group</title>
  <link rel="icon" type="image/png" href="images/favicon/favicon-96x96.png" sizes="96x96" />
  <link rel="icon" type="image/svg+xml" href="images/favicon/favicon.svg" />
  <link rel="shortcut icon" href="images/favicon/favicon.ico" />
  <link rel="apple-touch-icon" sizes="180x180" href="images/favicon/apple-touch-icon.png" />
  <link rel="manifest" href="images/favicon/site.webmanifest" />
  <link rel="stylesheet" href="stylesheet.css">
</head>

<body>
  <header class="site-header">
    <div class="header-top">
      <a class="brand" href="#">
        <img class="logo" src="images/logo/SCG Logo v2.png" alt="Signal Computer Group logo" />
        <span>Signal Computer Group</span>
      </a>
      <div class="header-right">
        <div class="top-links">
          <a href="#">Deals</a>
          <a href="#">Support</a>
          <a href="#">Cart</a>
        </div>

        <form class="searchbar" action="#" method="get" role="search">
          <label class="visually-hidden" for="site-search">Search computer parts</label>
          <div class="search-field">
            <span class="search-icon" aria-hidden="true">🔍</span>
            <input id="site-search" name="q" type="search" placeholder="Search CPUs, GPUs, RAM..." autocomplete="off" />
          </div>
          <button type="submit">Search</button>
        </form>
      </div>
    </div>

    <nav class="menu-bar">
      <ul>
        <li><a href="#"><span>Home</span></a></li>
        <li><a href="#"><span>CPUs</span></a></li>
        <li><a href="#"><span>GPUs</span></a></li>
        <li><a href="#"><span>Motherboards</span></a></li>
        <li><a href="#"><span>RAM</span></a></li>
        <li><a href="#"><span>Storage</span></a></li>
        <li><a href="#"><span>Power Supplies</span></a></li>
        <li><a href="#"><span>Cases</span></a></li>
      </ul>
    </nav>
  </header>

  <main class="page-main">
    <section class="hero">
      <div class="hero-content">
        <h1>Build Your Dream PC</h1>
        <p>Premium computer parts for gamers, creators, and professionals. Quality components at competitive prices.</p>
        <a href="#" class="cta-button">Shop Now</a>
      </div>
      <div class="hero-image">
        <img src="images/pc_parts/custom pc.webp" alt="Custom PC Build" />
      </div>
    </section>

    <section class="featured-categories">
      <h2>Shop by Category</h2>
      <div class="categories-grid">
        <div class="category-card">
          <div class="category-icon">🖥️</div>
          <h3>CPUs</h3>
          <p>High-performance processors from Intel and AMD</p>
          <a href="#" class="category-link">Browse CPUs</a>
        </div>
        <div class="category-card">
          <div class="category-icon">🎮</div>
          <h3>GPUs</h3>
          <p>Graphics cards for gaming and rendering</p>
          <a href="#" class="category-link">Browse GPUs</a>
        </div>
        <div class="category-card">
          <div class="category-icon">💾</div>
          <h3>RAM</h3>
          <p>Fast memory modules for optimal performance</p>
          <a href="#" class="category-link">Browse RAM</a>
        </div>
        <div class="category-card">
          <div class="category-icon">🔌</div>
          <h3>Motherboards</h3>
          <p>Reliable boards for every build</p>
          <a href="#" class="category-link">Browse Motherboards</a>
        </div>
        <div class="category-card">
          <div class="category-icon">⚡</div>
          <h3>Power Supplies</h3>
          <p>Efficient PSUs for stable power</p>
          <a href="#" class="category-link">Browse PSUs</a>
        </div>
        <div class="category-card">
          <div class="category-icon">🗄️</div>
          <h3>Storage</h3>
          <p>SSDs and HDDs for data storage</p>
          <a href="#" class="category-link">Browse Storage</a>
        </div>
      </div>
    </section>

    <section class="deals">
      <h2>Hot Deals</h2>
      <div class="deals-grid">
        <div class="deal-card">
          <div class="deal-badge">Save 20%</div>
          <img src="images/pc_parts/rtx4090.jpg" alt="RTX 4090" />
          <h4>RTX 4090 Graphics Card</h4>
          <p class="price">$599 <span class="old-price">$700</span></p>
          <a href="#" class="deal-link">View Deal</a>
        </div>
        <div class="deal-card">
          <div class="deal-badge">New</div>
          <img src="images/pc_parts/intelcorei9.jpg" alt="Intel i9" />
          <h4>Intel Core i9-14900K</h4>
          <p class="price">$450</p>
          <a href="#" class="deal-link">View Deal</a>
        </div>
        <div class="deal-card">
          <div class="deal-badge">Bundle</div>
          <img src="images/pc_parts/32gbddr5ram.jpg" alt="RAM Kit" />
          <h4>Corsair Vengeance 32GB DDR5</h4>
          <p class="price">$300</p>
          <a href="#" class="deal-link">View Deal</a>
        </div>
      </div>
    </section>
  </main>
</body>
</html>
